# The pre-registration lock (docs/2026-11-15-prereg-login.md).
#
# On the rented server this file is C:\flyff-web\.env (the deploy scripts never write it).
# With npm run gateway and npm run web (your PC or the VM) it is apps\gateway\.env.
# The gateway and the web service read it again a second or two after you save it: no restart.
#
# PREREG_ONLY=true    only the accounts below may log in to the game; everyone else is told
#                     "Pre-registration only: the server isn't open yet."
# PREREG_ONLY=false   everyone may log in (the same as no file, or no PREREG_ONLY line)
#
# PREREG_ALLOWED_ACCOUNTS: account names split by commas. Capitals and spaces do not matter.
# Empty while PREREG_ONLY=true: nobody may log in. GM accounts get in only if they are listed too.
#
# PREREG_MAX_ACCOUNTS_PER_IP: while PREREG_ONLY=true, how many accounts one internet connection (IP) may sign up
# in all, and one browser too. No line: 3. 0: no cap. Signing up is open otherwise.

PREREG_ONLY=true
PREREG_ALLOWED_ACCOUNTS=youraccount, friend1, friend2
PREREG_MAX_ACCOUNTS_PER_IP=3
