+
+// Room for one more pair: every pair older than ACCOUNT_CACHE_KEEP goes, or, when there is none, the oldest one.
+void CAccountMgr::MakeRoom( time_t tmCur )
+{
+	BOOL bRemoved	= FALSE;
+	map< ACCOUNT_KEY, ACCOUNT_CACHE >::iterator oldest	= m_cache.end();
+	for( map< ACCOUNT_KEY, ACCOUNT_CACHE >::iterator it = m_cache.begin(); it != m_cache.end(); )
+	{
+		if( tmCur - it->second.m_tmError > ACCOUNT_CACHE_KEEP )
+		{
+			it	= m_cache.erase( it );
+			bRemoved	= TRUE;
+			continue;
+		}
+		if( oldest == m_cache.end() || it->second.m_tmError < oldest->second.m_tmError )
+			oldest	= it;
+		++it;
+	}
+	if( !bRemoved && oldest != m_cache.end() )
+		m_cache.erase( oldest );
 }
 
