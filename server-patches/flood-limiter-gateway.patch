 #include "stdafx.h"
 #include "dos2.h"
 
+u_long	CDos2::s_aExempt[MAX_EXEMPT];
+int		CDos2::s_nExempt	= 0;
+
+// A dotted IPv4 address "a.b.c.d": digits and exactly three dots, at most 15 characters.
+static BOOL IsDottedIPv4( const char* lpszAddr )
+{
+	int nDots	= 0;
+	int nLen	= lstrlen( lpszAddr );
+	if( nLen < 7 || nLen > 15 )
+		return FALSE;
+	for( int i = 0; i < nLen; i++ )
+	{
+		if( lpszAddr[i] == '.' )
+			nDots++;
+		else if( lpszAddr[i] < '0' || lpszAddr[i] > '9' )
+			return FALSE;
+	}
+	return( nDots == 3 && inet_addr( lpszAddr ) != INADDR_NONE );
+}
+
+// Filled while the ini file is read, before the listen thread starts, and only read after that: no lock.
+BOOL CDos2::AddExempt( const char* lpszAddr )
+{
+	if( s_nExempt >= MAX_EXEMPT || !IsDottedIPv4( lpszAddr ) )
+		return FALSE;
+	s_aExempt[s_nExempt++]	= inet_addr( lpszAddr );
+	return TRUE;
+}
+
+BOOL CDos2::IsExempt( u_long addr )
+{
+	for( int i = 0; i < s_nExempt; i++ )
+	{
+		if( s_aExempt[i] == addr )
+			return TRUE;
+	}
+	return FALSE;
+}
+
