+// A dotted IPv4 address "a.b.c.d": digits and exactly three dots, at most 15 characters.
+static BOOL IsDottedIPv4( const char* lpszAddr )
+{
+	int nDots	= 0;
+	int nLen	= lstrlen( lpszAddr );
+	if( nLen < 7 || nLen > 15 )
+		return FALSE;
+	for( int i = 0; i < nLen; i++ )
+	{
+		if( lpszAddr[i] == '.' )
+			nDots++;
+		else if( lpszAddr[i] < '0' || lpszAddr[i] > '9' )
+			return FALSE;
+	}
+	return( nDots == 3 && inet_addr( lpszAddr ) != INADDR_NONE );
+}
+
+// Certifier.ini 'Gateway "a.b.c.d"' (repeatable, at most 8): the WebSocket gateways that may
+// tell us a browser player's real address. With no Gateway line, no address is ever accepted.
+void CDPCertifier::AddGateway( const char* lpszAddr )
+{
+	if( m_nGateway >= 8 || !IsDottedIPv4( lpszAddr ) )
+	{
+		Error( "Gateway %s not added", lpszAddr );
+		return;
+	}
+	lstrcpy( m_aszGateway[m_nGateway], lpszAddr );
+	m_nGateway++;
+}
+
+BOOL CDPCertifier::IsGateway( DPID dpid )
+{
+	DWORD dwAddr	= GetPlayerAddr( dpid );
+	if( dwAddr == 0 )
+		return FALSE;
+	for( int i = 0; i < m_nGateway; i++ )
+	{
+		if( inet_addr( m_aszGateway[i] ) == dwAddr )
+			return TRUE;
+	}
+	return FALSE;
+}
+
+// The player's address: the one a gateway sent (OnGatewayClientAddr), else the socket's.
+void CDPCertifier::GetClientAddr( DPID dpid, LPSTR lpAddr )
+{
+	char szAddr[16]	= { 0, };
+	{
+		CMclAutoLock	Lock( CUserMng::GetInstance()->m_AddRemoveLock );
+		CUser* pUser	= CUserMng::GetInstance()->GetUser( dpid );
+		if( pUser )
+			lstrcpy( szAddr, pUser->GetClientAddr() );
+	}
+	if( szAddr[0] != '\0' )
+		lstrcpy( lpAddr, szAddr );
+	else
+		GetPlayerAddr( dpid, lpAddr );
+}
+
+DWORD CDPCertifier::GetClientAddr( DPID dpid )
+{
+	char szAddr[16]	= { 0, };
+	{
+		CMclAutoLock	Lock( CUserMng::GetInstance()->m_AddRemoveLock );
+		CUser* pUser	= CUserMng::GetInstance()->GetUser( dpid );
+		if( pUser )
+			lstrcpy( szAddr, pUser->GetClientAddr() );
+	}
+	if( szAddr[0] != '\0' )
+		return inet_addr( szAddr );
+	return GetPlayerAddr( dpid );
+}
