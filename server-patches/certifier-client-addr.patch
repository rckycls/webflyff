+// Sent by a gateway as the first packet of a browser player's connection: the player's
+// dotted IPv4 address. Accepted only from a listed gateway and only before CERTIFY.
+void CDPCertifier::OnGatewayClientAddr( CAr & ar, DPID dpid, LPBYTE lpBuf, u_long uBufSize )
+{
+	char szAddr[16]	= { 0, };
+	ar.ReadString( szAddr, 16 );
+
+	if( IsGateway( dpid ) && IsDottedIPv4( szAddr ) )
+	{
+		CMclAutoLock	Lock( CUserMng::GetInstance()->m_AddRemoveLock );
+		CUser* pUser	= CUserMng::GetInstance()->GetUser( dpid );
+		if( pUser && pUser->GetAccount()[0] == '\0' )
+		{
+			pUser->SetClientAddr( szAddr );
+			return;
+		}
+	}
+
+	char szPeer[16]	= { 0, };
+	GetPlayerAddr( dpid, szPeer );
+	Error( "GATEWAY_CLIENT_ADDR refused from %s", szPeer );
+}
