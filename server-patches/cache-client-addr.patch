+// FlyffWeb (cache-client-addr.patch): sent by a WebSocket gateway as the first packet of a browser player's
+// connection, after DPID_UNKNOWN like every packet to this server: the player's dotted IPv4 address. Taken only
+// from a listed gateway (CacheServer.ini Gateway lines) and only before JOIN (AcceptClientAddr, GatewayAddr.cpp).
+// OnAddConnection's SetAddr then makes it the player's address, which goes to the core server
+// (CDPCoreClient::SendAddPlayer, DPCoreClient.cpp:101) and to the world server (CDPClient::SendJoin, DPClient.cpp:92)
+// in place of the gateway's address. As CDPCertifier::OnGatewayClientAddr (CERTIFIER/DPCertifier.cpp:315).
+void CDPCacheSrvr::OnGatewayClientAddr( CAr & ar, DPID dpid, LPBYTE, u_long )
+{
+	char szAddr[16]	= { 0, };
+	ar.ReadString( szAddr, 16 );		// a longer string is read as an empty one (CAr::ReadString), which is refused
+	char szPeer[16]	= { 0, };
+	GetPlayerAddr( dpid, szPeer );		// the connection's own address; it stays empty if it can't be read
+
+	{
+		CMclAutoLock	Lock( CPlayerMng::Instance()->m_AddRemoveLock );
+		CPlayer* pPlayer	= CPlayerMng::Instance()->GetPlayer( dpid );
+		if( pPlayer && AcceptClientAddr( g_GatewayList, szPeer, pPlayer->IsJoined(), szAddr ) )
+		{
+			pPlayer->SetClientAddr( szAddr );
+			return;
+		}
+	}
+	Error( "GATEWAY_CLIENT_ADDR refused from %s", szPeer );
+}
+
 CDPCacheSrvr	g_DPCacheSrvr;
