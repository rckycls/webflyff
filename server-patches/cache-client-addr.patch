--- /dev/null
+++ b/Source/CACHESERVER/GatewayAddr.h
@@ -0,0 +1,34 @@
+#ifndef __GATEWAYADDR_H__
+#define __GATEWAYADDR_H__
+
+// FlyffWeb (cache-client-addr.patch): the rules for the player's real address that a WebSocket gateway sends in
+// PACKETTYPE_GATEWAY_CLIENT_ADDR (CDPCacheSrvr::OnGatewayClientAddr). They are kept apart from the network code,
+// so that the test program (FlyffWeb/server-patches/tests/cache-test.cpp) builds them alone.
+
+#define	MAX_GATEWAY		8
+
+// CacheServer.ini 'Gateway "a.b.c.d"' (repeatable, at most MAX_GATEWAY): the gateways that may tell us a browser
+// player's real address. With no Gateway line, no address is ever accepted. Filled while Script reads the ini file,
+// before the server starts, and only read after that: no lock.
+// The same rules as CDPCertifier::AddGateway and IsGateway (CERTIFIER/DPCertifier.cpp:92 and :106).
+class CGatewayList
+{
+public:
+	CGatewayList();
+	BOOL	Add( const char* lpszAddr );			// FALSE, and nothing added, for a bad address or a ninth one
+	BOOL	IsListed( const char* lpszAddr ) const;	// lpszAddr as GetPlayerAddr writes it (Net/Src/serversock.cpp:469)
+	int		GetCount( void ) const	{	return m_nAddr;	}
+private:
+	u_long	m_aAddr[MAX_GATEWAY];	// inet_addr of each listed address
+	int		m_nAddr;
+};
+
+// A dotted IPv4 address "a.b.c.d": digits and exactly three dots, at most 15 characters.
+// Copied from IsDottedIPv4 (CERTIFIER/DPCertifier.cpp:74, certifier-client-addr.patch).
+BOOL	IsDottedIPv4( const char* lpszAddr );
+
+// Whether CDPCacheSrvr::OnGatewayClientAddr takes szAddr as the player's address: the connection's own address
+// (szPeer) is a listed gateway, the player hasn't sent JOIN yet (bJoined), and szAddr is a dotted IPv4 address.
+BOOL	AcceptClientAddr( const CGatewayList & gateways, const char* szPeer, BOOL bJoined, const char* szAddr );
+
+#endif	// __GATEWAYADDR_H__
--- /dev/null
+++ b/Source/CACHESERVER/GatewayAddr.cpp
@@ -0,0 +1,57 @@
+#include "stdafx.h"
+#include "GatewayAddr.h"
+
+// FlyffWeb (cache-client-addr.patch): see GatewayAddr.h.
+
+// Copied from IsDottedIPv4 (CERTIFIER/DPCertifier.cpp:74, certifier-client-addr.patch).
+BOOL IsDottedIPv4( const char* lpszAddr )
+{
+	int nDots	= 0;
+	int nLen	= lstrlen( lpszAddr );
+	if( nLen < 7 || nLen > 15 )
+		return FALSE;
+	for( int i = 0; i < nLen; i++ )
+	{
+		if( lpszAddr[i] == '.' )
+			nDots++;
+		else if( lpszAddr[i] < '0' || lpszAddr[i] > '9' )
+			return FALSE;
+	}
+	return( nDots == 3 && inet_addr( lpszAddr ) != INADDR_NONE );
+}
+
+CGatewayList::CGatewayList()
+{
+	memset( m_aAddr, 0, sizeof(m_aAddr) );
+	m_nAddr	= 0;
+}
+
+// As CDPCertifier::AddGateway (CERTIFIER/DPCertifier.cpp:92), which also logs the refusal: Script does that here.
+BOOL CGatewayList::Add( const char* lpszAddr )
+{
+	if( m_nAddr >= MAX_GATEWAY || !IsDottedIPv4( lpszAddr ) )
+		return FALSE;
+	m_aAddr[m_nAddr++]	= inet_addr( lpszAddr );
+	return TRUE;
+}
+
+// As CDPCertifier::IsGateway (CERTIFIER/DPCertifier.cpp:106), which compares inet_addr of each listed address with the
+// connection's address. An address that isn't dotted IPv4 (an empty one, when GetPlayerAddr fails) is never listed.
+BOOL CGatewayList::IsListed( const char* lpszAddr ) const
+{
+	if( !IsDottedIPv4( lpszAddr ) )
+		return FALSE;
+	u_long uAddr	= inet_addr( lpszAddr );
+	for( int i = 0; i < m_nAddr; i++ )
+	{
+		if( m_aAddr[i] == uAddr )
+			return TRUE;
+	}
+	return FALSE;
+}
+
+// As CDPCertifier::OnGatewayClientAddr (CERTIFIER/DPCertifier.cpp:315), with JOIN in place of CERTIFY.
+BOOL AcceptClientAddr( const CGatewayList & gateways, const char* szPeer, BOOL bJoined, const char* szAddr )
+{
+	return( !bJoined && gateways.IsListed( szPeer ) && IsDottedIPv4( szAddr ) );
+}
