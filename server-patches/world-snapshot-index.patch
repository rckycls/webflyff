+
+// FlyffWeb (world-snapshot-index.patch): the table of contents for the browser client, after the last message:
+// each message's start counted from uFirst (CUser::Notify passes the first byte after the count field), the count
+// again (u16) and SNAPSHOT_INDEX_MARKER. Neuz reads only the counted messages, so it never reads this. The ReelIn
+// after sending removes it with the messages.
+void CSnapshot::AppendIndex( u_long uFirst )
+{
+	int nCount	= cb.Count();
+	for( int i = 0; i < nCount; i++ )
+		ar << (DWORD)( cb.Start( i ) - uFirst );
+	ar << (WORD)nCount;
+	ar << SNAPSHOT_INDEX_MARKER;
 }
