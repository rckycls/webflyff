+// FlyffWeb (world-snapshot-index.patch): the message count of a bundle, in place of the short it was. It reads,
+// compares and is written into a CAr like that short. Each cb++ also records where the new message starts in the
+// snapshot's ar, for the table of contents that CSnapshot::AppendIndex appends. Setting it to 0 clears the starts.
+#define	SNAPSHOT_INDEX_MARKER	(DWORD)0x31434F54	// the bytes "TOC1"
+
+class CSnapshotCount
+{
+public:
+	explicit	CSnapshotCount( CAr & ar ) : m_ar( ar ), m_cb( 0 )	{}
+
+	CSnapshotCount&	operator=( int n )	{	m_cb	= (short)n;	if( n == 0 )	Clear();	return *this;	}
+	operator short() const	{	return m_cb;	}
+	short	operator++( int )	{	m_auStart.push_back( m_ar.GetOffset() );	return m_cb++;	}
+
+	int		Count( void ) const		{	return (int)m_auStart.size();	}
+	u_long	Start( int i ) const	{	return m_auStart[i];	}
+	void	Clear( void )			{	m_auStart.clear();	}
+
+private:
+	CAr&	m_ar;
+	short	m_cb;
+	std::vector<u_long>	m_auStart;	// each message's ar.GetOffset() at its cb++
+
+	CSnapshotCount( const CSnapshotCount & );	// not copied: m_ar is its own snapshot's
+	CSnapshotCount&	operator=( const CSnapshotCount & );
+};
+
+inline CAr& operator<<( CAr & ar, const CSnapshotCount & cb )	{	return ar << (short)cb;	}
 
