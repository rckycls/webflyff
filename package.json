{
  "name": "flyffweb",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:corpus": "vitest run --config vitest.corpus.config.ts",
    "convert": "tsx tools/convert/src/cli.ts",
    "copy-basis": "node scripts/copy-basis.mjs",
    "dev:viewer": "npm run copy-basis && vite --config apps/viewer/vite.config.ts --host",
    "build:viewer": "vite build --config apps/viewer/vite.config.ts",
    "preview:viewer": "npm run copy-basis && vite preview --config apps/viewer/vite.config.ts --host"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
